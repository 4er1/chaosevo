apiVersion: batch/v1
kind: Job
metadata:
  name: chaosevo-{{ chaosevo_run_name }}
  namespace: {{ chaosevo_namespace }}
  labels:
    app: chaosevo
spec:
  backoffLimit: 0
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        app: chaosevo
    spec:
      serviceAccountName: chaosevo
      restartPolicy: Never
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: chaosevo
          image: {{ chaosevo_image }}
          imagePullPolicy: IfNotPresent
          args:
            - run
            - --config=/config/config.json
            - --metrics-bind=0.0.0.0
            - --metrics-port=9200
            - --linger={{ chaosevo_linger_seconds }}
            - --out=/results/results.json
          ports:
            - name: metrics
              containerPort: 9200
          readinessProbe:
            httpGet: {path: /healthz, port: metrics}
          volumeMounts:
            - {name: config, mountPath: /config, readOnly: true}
            - {name: results, mountPath: /results}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: ["ALL"]}
          resources:
            requests: {cpu: 50m, memory: 64Mi}
            limits: {cpu: 500m, memory: 256Mi}
      volumes:
        - name: config
          configMap:
            name: chaosevo-config
        - name: results
          emptyDir: {}
